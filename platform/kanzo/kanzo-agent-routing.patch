+function renderAgentConfig(task) {
+  const section = $("#p-agent-config");
+  section.hidden = task.project !== AGENT_CATALOG_PROJECT;
+  if (section.hidden) return;
+  const config = task.agent_config || Object.fromEntries(
+    (task.description || "").split(/\r?\n/).map((line) => {
+      const match = line.match(/^\s*(slug|repo|model_lane|provider|model|reason|profile|read_only)\s*:\s*(.*?)\s*$/i);
+      return match ? [match[1].toLowerCase(), match[2]] : null;
+    }).filter(Boolean));
+  const fields = [
+    ["#p-agent-slug", config.slug || ""], ["#p-agent-repo", config.repo || ""],
+    ["#p-agent-lane", config.model_lane || "analysis"], ["#p-agent-profile", config.profile || "researcher"],
+    ["#p-agent-provider", config.provider || "openai-api"], ["#p-agent-model", config.model || "iq_3s"],
+    ["#p-agent-reason", config.reason || "high"],
+  ];
+  for (const [selector, value] of fields) {
+    const field = $(selector);
+    if (document.activeElement !== field) field.value = value;
+  }
+  if (document.activeElement !== $("#p-agent-read-only")) {
+    $("#p-agent-read-only").checked = config.read_only === true || String(config.read_only).toLowerCase() === "true";
+  }
+}
+
+function saveAgentConfig() {
+  if (!panelTask || panelTask.project !== AGENT_CATALOG_PROJECT) return;
+  const config = {
+    slug: $("#p-agent-slug").value.trim(),
+    repo: $("#p-agent-repo").value.trim(),
+    model_lane: $("#p-agent-lane").value,
+    provider: $("#p-agent-provider").value.trim(),
+    model: $("#p-agent-model").value.trim(),
+    reason: $("#p-agent-reason").value,
+    profile: $("#p-agent-profile").value.trim(),
+    read_only: $("#p-agent-read-only").checked,
+  };
+  if (!config.slug) return;
+  patchTask({ agent_config: config });
+}
+
+for (const field of $("#p-agent-config").querySelectorAll("input, select")) {
+  field.addEventListener("change", saveAgentConfig);
+}
