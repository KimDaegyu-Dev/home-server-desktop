ui = true
disable_mlock = true

api_addr = "https://{{ vault_api_name }}:8200"
cluster_addr = "https://{{ vault_bind_address }}:8201"

storage "raft" {
  path    = "{{ vault_data_dir }}"
  node_id = "{{ k3s_node_name }}-vault"
}

listener "tcp" {
  address         = "{{ vault_bind_address }}:8200"
  cluster_address = "{{ vault_bind_address }}:8201"
  tls_cert_file   = "{{ vault_tls_chain }}"
  tls_key_file    = "{{ vault_tls_key }}"
}
