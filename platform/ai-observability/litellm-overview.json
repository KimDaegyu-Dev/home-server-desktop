{
  "title": "LiteLLM gateway",
  "uid": "litellm-gateway",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Gateway requests / minute",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (model) (rate(litellm_proxy_total_requests_metric_total[5m])) * 60", "legendFormat": "{{model}}", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tokens / minute",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (model) (rate(litellm_total_tokens_metric_total[5m])) * 60", "legendFormat": "{{model}}", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "LLM call duration",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{gen_ai_request_model}}", "refId": "A"}]
    }
  ]
}
